[PARAMETERS]
//#isInt? #name   #dist.#min  #max 
//all Ns are in number of haploid individuals
1  north.q1     logunif     100  1000000   output
1  north.q3     logunif     100  1000000   output
1  south.q2     logunif     100  1000000   output
1  Tdiv1         unif     10   10000    output
1  Tplus         unif     10  10000     hide
0  RESIZE1       unif     0.1  10     hide
0  RESIZE2	unif     0.1  10     hide

[COMPLEX PARAMETERS]
1 Tdiv2 = Tdiv1+Tplus output
1 Ancq13 = RESIZE1*north.q1
1 Ancq12 = RESIZE2*Ancq13
